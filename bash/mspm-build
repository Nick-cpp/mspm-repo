#!/bin/sh

depends=()

install() {
    if [ ! -f bash-5.3.tar.gz ]; then
        wget https://ftp.gnu.org/gnu/bash/bash-5.3.tar.gz
    fi
    tar -xf bash-5.3.tar.gz
    cd bash-5.3/
    ./configure --sysconfdir=/etc --prefix=/usr --libdir=/usr/lib
    make $MAKEOPTS
    make install DESTDIR="/tmp/mspm-test" $MAKEOPTS
}

remove() {
    cd bash-5.3/
    make uninstall DESTDIR="/tmp/mspm-test" $MAKEOPTS
}
