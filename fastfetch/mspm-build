#!/bin/sh

depends=("cmake-bin")

install() {
    if [ ! -f 2.68.1.tar.gz ]; then
        wget https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/2.68.1.tar.gz
    fi
    tar -xf 2.68.1.tar.gz
    cd fastfetch-2.68.1/
    ./run.sh
    cp build/fastfetch /usr/bin/fastfetch
}

remove() {
    rm -f /usr/bin/fastfetch
}
