#!/bin/bash

version="7.1.0"
depends=("bash")

install() {
    if [ ! -f $version.tar.gz ]; then
        wget https://github.com/dylanaraps/neofetch/archive/refs/tags/$version.tar.gz
    fi
    rm -rf neofetch/
    mkdir -p neofetch/
    tar -xf $version.tar.gz -C neofetch --strip-components=1
    cd neofetch/
    make install
}

remove() {
    cd neofetch/
    make uninstall
}
