#!/bin/bash

version="2.9.0"
depends=("make" "gcc" "glibc" "tar")

install() {
    rm -f expat-$version.tar.xz
    wget https://github.com/libexpat/libexpat/releases/download/R_2_9_0/expat-$version.tar.xz
    rm -rf expat/
    mkdir -p expat/
    tar -xf expat-$version.tar.xz -C expat --strip-components=1
    cd expat/
    ./configure --prefix=/usr
    make
    make install
}

remove() {
    cd expat/
    make uninstall
}
