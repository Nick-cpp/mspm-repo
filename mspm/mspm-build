#!/bin/sh

version="3.0"
depends=("bash")

install() {
    if [ ! -f 3.0.tar.gz ]; then
        wget https://github.com/Nick-cpp/mspm/archive/refs/tags/3.0.tar.gz
    fi
    mkdir -p mspm/
    tar -xf 3.0.tar.gz -C mspm/ --strip-components=1
    cd mspm/
    chmod +x mspm
    cp mspm /usr/bin/
}

remove() {
    rm -f /usr/bin/mspm
}
